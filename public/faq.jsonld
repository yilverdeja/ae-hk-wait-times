{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Where should I go for minor illnesses in Hong Kong?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Public A&E departments prioritise critical and emergency cases. Semi-urgent and non-urgent patients may wait longer. If your condition is minor, consider private clinics or primary care services instead of A&E."
      }
    },
    {
      "@type": "Question",
      "name": "How does the A&E triage system work in Hong Kong?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Hospital Authority A&E departments triage patients into five categories (I–V) by clinical urgency. Category I (critical) and II (emergency) are seen first; Category IV (semi-urgent) and V (non-urgent) typically wait longest."
      }
    },
    {
      "@type": "Question",
      "name": "What do the wait times mean?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The main wait-time table shows the 95th percentile wait for semi-urgent (Category IV) and non-urgent (Category V) patients, based on the past few hours. This means most patients in those categories waited less than the time shown. It is a reference only, not a guarantee. On the map view and individual hospital pages, you can also view wait times for other triage categories (urgent, emergency, critical)."
      }
    },
    {
      "@type": "Question",
      "name": "How do sudden emergencies affect A&E wait times?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "When a hospital receives sudden severe cases — such as major accidents or heart attacks — staff and resources are directed to those patients first. Waits for semi-urgent and non-urgent patients can increase quickly, and the spike may not show up in historical wait figures right away."
      }
    },
    {
      "@type": "Question",
      "name": "Where does the trend data come from?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Trend charts use historical waiting time records from the Hospital Authority open data programme, dating back to 2018. We analyse this dataset to show average waits by day and hour across Hong Kong public A&E departments."
      }
    },
    {
      "@type": "Question",
      "name": "What is the best time of day to visit an A&E department?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Based on historical trends across all hospitals, 12 PM to 1 PM often shows the lowest waits. Early mornings and late nights tend to be busiest. Check live waits on our site before you travel."
      }
    },
    {
      "@type": "Question",
      "name": "How often is waiting time data updated?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Our site refreshes wait time data approximately every 15 minutes from official Hospital Authority sources. We source data from the Hospital Authority official API on data.gov.hk, the same underlying source as the HA wait-time page, with enhanced filtering and trends."
      }
    },
    {
      "@type": "Question",
      "name": "Why does ae.wait.hk focus on semi-urgent and non-urgent categories?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Patients in Category IV and V often have time to compare hospitals before travelling. Those in critical, emergency, or urgent categories should seek care immediately rather than comparing waits. Higher Cat IV/V waits often correlate with busier departments overall."
      }
    },
    {
      "@type": "Question",
      "name": "What do critical and emergency management status icons mean?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "On the wait-time table, icons next to a hospital name show when the Hospital Authority reports the department is managing critical or emergency cases. These often appear during busy periods and can mean longer waits for semi-urgent and non-urgent patients. A yellow warning triangle means the hospital is managing at least one critical or emergency case. A red siren means multiple critical cases."
      }
    },
    {
      "@type": "Question",
      "name": "How can I see trend data for a hospital?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "On the home page, click a hospital row to open a panel with live busyness, hourly trends, and contact details. To see the full trend chart and wait times by triage category, go to All Hospitals and select a hospital."
      }
    },
    {
      "@type": "Question",
      "name": "How can I determine my triage category before visiting A&E?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "You cannot know your triage category before arrival. The Hospital Authority does not disclose this in advance. An experienced nurse assesses you after registration and assigns Category I–V based on clinical need."
      }
    },
    {
      "@type": "Question",
      "name": "I have more questions about the Hospital Authority — where should I look?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "This site is not affiliated with or endorsed by the Hospital Authority. For official information about A&E services, triage, and how public hospitals prioritise patients, please visit the HA Service Guide."
      }
    },
    {
      "@type": "Question",
      "name": "How much does it cost to attend an A&E department in Hong Kong?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "From 1 January 2026, eligible persons (valid HKID) pay HK$400 per public hospital A&E visit. Patients triaged as Category I (critical) or II (emergency) are fee-exempt. Non-eligible persons pay HK$2,100 with no exemptions. Fees are set by the Hospital Authority. For the latest fee details, see the official Hospital Authority fees page."
      }
    },
    {
      "@type": "Question",
      "name": "How are wait times predicted?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Trend charts show estimated waits for the next 1, 2, and 3 hours. These forecasts use a machine learning model trained on recent Hospital Authority historical data. They are for reference only and are not medical advice. When waits are very high (above 8 hours), predictions may be hidden or adjusted upward so they are not unrealistically low."
      }
    }
  ]
}
