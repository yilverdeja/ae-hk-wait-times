{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Where should I go for minor illnesses in Hong Kong?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Public A&E departments prioritise critical and emergency cases. Semi-urgent and non-urgent patients may wait longer. If your condition is minor, consider private clinics or primary care services instead of A&E."
      }
    },
    {
      "@type": "Question",
      "name": "How does the A&E triage system work in Hong Kong?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Hospital Authority A&E departments triage patients into five categories (I–V) by clinical urgency. Category I (critical) and II (emergency) are seen first; Category IV (semi-urgent) and V (non-urgent) typically wait longest."
      }
    },
    {
      "@type": "Question",
      "name": "How is A&E wait time data calculated?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Displayed wait times are a historical reference from the last few hours for Triage Categories IV (semi-urgent) and V (non-urgent) only. The figure shown is the 95th percentile in 0.5-hour increments, for reference only."
      }
    },
    {
      "@type": "Question",
      "name": "How do sudden emergencies affect A&E wait times?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Sudden severe cases (accidents, heart attacks, etc.) divert A&E resources and can lengthen waits for less urgent patients. Icons showing a hospital is managing critical or emergency cases indicate heavy demand."
      }
    },
    {
      "@type": "Question",
      "name": "Where does the trend data come from?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Trend charts use historical waiting time records from the Hospital Authority open data programme, dating back to 2018. We analyse this dataset to show average waits by day and hour across Hong Kong public A&E departments."
      }
    },
    {
      "@type": "Question",
      "name": "What is the best time of day to visit an A&E department?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Based on historical trends across all hospitals, 12 PM to 1 PM often shows the lowest waits. Early mornings and late nights tend to be busiest. Check live waits on ae.wait.hk before you travel."
      }
    },
    {
      "@type": "Question",
      "name": "How often is waiting time data updated?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "ae.wait.hk refreshes approximately every 15 minutes from the Hospital Authority official API on data.gov.hk, so you see the same underlying source as the HA wait-time page with enhanced filtering and trends."
      }
    },
    {
      "@type": "Question",
      "name": "Why does ae.wait.hk focus on semi-urgent and non-urgent categories?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Patients in Category IV and V often have time to compare hospitals before travelling. Those in critical, emergency, or urgent categories should seek care immediately rather than comparing waits. Higher Cat IV/V waits often correlate with busier departments overall."
      }
    },
    {
      "@type": "Question",
      "name": "What do critical and emergency management status icons mean?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "These icons show whether a hospital is actively managing Category I (critical) or Category II (emergency) cases. When resources are focused on high-priority patients, waits for semi-urgent and non-urgent categories may increase significantly."
      }
    },
    {
      "@type": "Question",
      "name": "How can I see trend data for a hospital?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "On the home page, click a hospital row to open a panel with live busyness, hourly trends, and contact details. Or visit a hospital page at /hospital/{slug} for the full trend chart and wait times by triage category."
      }
    },
    {
      "@type": "Question",
      "name": "How can I determine my triage category before visiting A&E?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "You cannot know your triage category before arrival. The Hospital Authority does not disclose this in advance. An experienced nurse assesses you after registration and assigns Category I–V based on clinical need."
      }
    },
    {
      "@type": "Question",
      "name": "How much does it cost to attend an A&E department in Hong Kong?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "From 1 January 2026, eligible persons (valid HKID) pay HK$400 per public hospital A&E visit. Patients triaged as Category I (critical) or II (emergency) are fee-exempt. Non-eligible persons pay HK$2,100 with no exemptions. Fees are set by the Hospital Authority."
      }
    },
    {
      "@type": "Question",
      "name": "How are wait times predicted?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Predictions use a machine learning model trained on about 8 months of HA historical data, shown at +1h, +2h, and +3h on trend charts. Forecasts are capped below 8 hours and are for reference only — not medical advice."
      }
    }
  ]
}